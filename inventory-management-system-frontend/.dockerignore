# Dependencies — never needed in the image build context
node_modules/

# NOTE: dist/ is intentionally NOT ignored — the frontend image serves the
# natively-built dist/ (see Dockerfile). If you switch to Dockerfile.multistage,
# add `dist/` back here so the in-Docker build produces it fresh.

# Env / local files
.env
.env.*
*.local

# IDE / editor metadata
.idea/
.vscode/

# VCS
.git/
.gitignore

# Logs
npm-debug.log*
*.log
