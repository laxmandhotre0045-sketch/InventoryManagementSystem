# Backend API base URL — includes the /api/v1 prefix.
#
# The default is RELATIVE, so it works out of the box in both environments:
#   • local dev  -> the Vite dev server proxies /api to the backend (vite.config.js)
#   • Docker/VPS -> nginx proxies /api to the backend container
#
# For a forwarded/tunnel backend on a DIFFERENT origin, DO NOT edit this file.
# Instead create ".env.local" (git-ignored) and set an absolute URL, e.g.
#   VITE_API_URL=https://your-backend-tunnel.ngrok-free.app/api/v1
VITE_API_URL=/api/v1
