# syntax=docker/dockerfile:1
#
# Self-contained multi-stage build (builds the app inside Docker).
# Use this on a host with enough RAM (this project's default low-RAM host
# uses the top-level Dockerfile, which serves a natively-built ./dist instead).
#
#   To use:  docker build -f Dockerfile.multistage -t frontend .
#
###############################################################################
# Stage 1 — Build the React (Vite) app
###############################################################################
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

###############################################################################
# Stage 2 — Serve the static build with Nginx
###############################################################################
FROM nginx:1.27-alpine AS runtime
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1
