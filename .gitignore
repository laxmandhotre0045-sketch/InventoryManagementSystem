# =============================================================================
# Secrets — never commit real credentials
# =============================================================================
.env
.env.*
!.env.example
# Frontend build-time config is non-secret (Vite exposes VITE_* to the client),
# so the committed default is allowed; local/tunnel overrides go in .env.local.
!inventory-management-system-frontend/.env

# Database dumps — they contain user rows and password hashes. Never commit a new
# one. (The single historical dump already in git is referenced by DEPLOYMENT.md's
# restore path; rotate the credentials it contains rather than relying on secrecy.)
backups/*.sql
db-backups/*.sql
*.sql.gz

# =============================================================================
# Backend (Maven / Java)
# =============================================================================
Inventory-System-New/target/
*.jar
*.war
*.class
Inventory-System-New/.mvn/wrapper/maven-wrapper.jar

# Uploaded invoice files (runtime data, kept in a Docker volume)
Inventory-System-New/uploads/

# =============================================================================
# Frontend (Node / Vite)
# =============================================================================
inventory-management-system-frontend/node_modules/
inventory-management-system-frontend/dist/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================================================
# IDE / editor / OS
# =============================================================================
.idea/
.vscode/
.settings/
.metadata/
.classpath
.project
.factorypath
*.iml
.DS_Store
Thumbs.db

# =============================================================================
# Logs
# =============================================================================
*.log

# Local dev/one-off scripts containing credentials — never commit
update_admin_password.py
update_pwd.sql

# Spreadsheet exports of the live database (emails, prices) — never commit.
exports/
