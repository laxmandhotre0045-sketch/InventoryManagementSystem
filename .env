# Local development defaults — ready to run `docker compose up --build`.
# For production, change the password and JWT secret to strong random values.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=Laxman@1234#
MYSQL_DATABASE=inventory
MYSQL_PORT=3306

# --- Backend --- (frontend calls http://localhost:8081, so publish backend here)
BACKEND_PORT=8081
JWT_SECRET=MySuperSecretKeyForJwtSigningDontUseInProduction
JWT_EXPIRATION_MS=3600000

# --- Frontend ---
FRONTEND_PORT=5173
