# =============================================================================
# The ONLY file you edit when moving between local and the Hostinger VPS.
# No Java, properties, or JS file contains an environment-specific host.
# =============================================================================

# --- Environment ---
# dev  = verbose SQL logging, permissive CORS
# prod = quiet logging, tuned for the server
SPRING_PROFILES_ACTIVE=prod

# --- MySQL ---
MYSQL_ROOT_PASSWORD=Laxman@1234#
MYSQL_DATABASE=inventory
# Host-side port only. Local MySQL already uses 3306, so the container
# publishes on 3310 (the backend still reaches the DB internally at mysql:3306).
MYSQL_PORT=3310
# Point these at an external/managed database if you don't run MySQL in Docker.
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root

# --- Backend ---
BACKEND_PORT=8091
API_VERSION=v1
# Freshly generated 48-byte key. The previous value was the example string from
# this repo, which the prod profile now refuses to start with — a published
# signing key lets anyone forge an ADMIN token. Regenerate any time with:
#   openssl rand -base64 48
# Note: changing this invalidates every issued token, so users log in again.
JWT_SECRET=nq2kUJWgla64PaIApXkgS7Z2FEXbRHOoVfVE5psXhi8xetYu4gOV2nzalQ3QGkLS
JWT_EXPIRATION_MS=3600000
# The SPA is served same-origin through nginx, so CORS is not required.
# Restrict this if you expose the API to another domain, e.g.
#   CORS_ALLOWED_ORIGINS=https://inventory.sensovibe.com
CORS_ALLOWED_ORIGINS=*

# --- Account seeding: OFF ------------------------------------------------------
# The master admin already exists in the database, so nothing needs seeding.
# Leaving this off is what guarantees no demo account can reappear on restart.
#
# This file is tracked in git, so no password belongs here. To provision an
# account on a brand-new, empty database, pass the values for a single boot
# instead of committing them:
#   SEED_DEFAULT_USERS=true SEED_ADMIN_EMAIL=you@example.com \
#     SEED_ADMIN_PASSWORD='<strong password>' docker compose up -d backend
# then set it back to false and restart.
SEED_DEFAULT_USERS=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# --- Frontend ---
# Open the app at http://localhost:8090 — the SPA calls /api/v1 on this same
# origin and nginx proxies it to the backend container. Nothing to change on deploy.
FRONTEND_PORT=8090
