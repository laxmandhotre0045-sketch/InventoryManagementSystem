# =============================================================================
# Copy to .env and adjust. This is the ONLY file that differs between
# local development and the production VPS.
#   cp .env.example .env
# =============================================================================

# --- Environment ---   dev | prod
SPRING_PROFILES_ACTIVE=prod

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_DATABASE=inventory
MYSQL_PORT=3307
DB_HOST=mysql          # or an external DB host / managed instance
DB_PORT=3306
DB_USERNAME=root

# --- Backend ---
BACKEND_PORT=8081
API_VERSION=v1         # bump to v2 to re-map every endpoint at once
JWT_SECRET=change_me_to_a_long_random_secret_key_at_least_32_chars
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=*   # e.g. https://inventory.sensovibe.com

# --- Frontend ---
FRONTEND_PORT=5173
