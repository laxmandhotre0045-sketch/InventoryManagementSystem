# =============================================================================
# Copy to .env and adjust. This is the ONLY file that differs between
# local development and the production VPS.
#   cp .env.example .env
#
# The ports below are the ones DEPLOYMENT.md documents and the stack is deployed
# on. Change them only if something else on the host already holds them.
# =============================================================================

# --- Environment ---   dev | prod
SPRING_PROFILES_ACTIVE=prod

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_DATABASE=inventory
MYSQL_PORT=3310        # bound to 127.0.0.1 only
DB_HOST=mysql          # or an external DB host / managed instance
DB_PORT=3306
DB_USERNAME=root

# --- Backend ---
BACKEND_PORT=8091      # bound to 127.0.0.1 only; reached via the frontend's nginx
API_VERSION=v1         # bump to v2 to re-map every endpoint at once
# REQUIRED under the prod profile. The app refuses to boot with this placeholder,
# because a known signing key lets anyone forge an admin token.
#   generate with:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_key_at_least_32_chars
JWT_EXPIRATION_MS=3600000

# Comma-separated origins allowed to call the API.
#
# Browsers send an Origin header on POSTs even SAME-ORIGIN, so this is checked on
# every login: if the address people actually use isn't listed here, sign-in fails
# with 403 "Invalid CORS request" — which looks like a password problem but isn't.
# List every address the app is reached on, including the LAN one used by the
# phone-QR capture feature. Example:
#   CORS_ALLOWED_ORIGINS=https://inventory.example.com,http://192.168.1.44:8090
CORS_ALLOWED_ORIGINS=*

# --- First admin account -----------------------------------------------------
# Off by default in prod so the demo credentials (admin@inventory.com / admin123)
# are never created on a server. For the very first boot set:
#   SEED_DEFAULT_USERS=true
#   SEED_ADMIN_EMAIL=you@yourcompany.com
#   SEED_ADMIN_PASSWORD=<a strong password>
# then set SEED_DEFAULT_USERS back to false and restart.
SEED_DEFAULT_USERS=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Frontend ---
FRONTEND_PORT=8090     # the only port published to the network

# --- AI features: invoice extraction + voice commands (OpenAI) ----------------
# Leave OPENAI_API_KEY blank to run on the mock/fallback. To enable real AI:
# set the key and INVOICE_OCR_PROVIDER=openai, then restart the backend.
INVOICE_OCR_PROVIDER=mock
OPENAI_API_KEY=

# Vision model used to read invoices. This choice decides extraction ACCURACY:
# gpt-4o and gpt-4.1 misplace decimal points in narrow invoice columns (reading a
# rate of 30.51 as 305.1, or 1.50 as 1.30), which silently changes stock value.
# gpt-5.4 reads them correctly and is the tested default.
#
# If you change this, note that the two model generations take different request
# parameters — GPT-4-era wants max_tokens + temperature, GPT-5-era requires
# max_completion_tokens and rejects temperature. OpenAiClient handles both, keyed
# off the model name, so a "gpt-4*" name must really be a GPT-4-era model.
OPENAI_MODEL=gpt-5.4

# Speech-to-text for the voice command feature (separate from the vision model).
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

OPENAI_BASE_URL=https://api.openai.com/v1
# Raise if large invoice photos time out on a slow connection.
OPENAI_TIMEOUT_MS=90000
