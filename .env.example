# Copy this file to `.env` and adjust values before running docker compose.
#   cp .env.example .env

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_DATABASE=inventory
MYSQL_PORT=3306

# --- Backend --- (frontend calls http://localhost:8081, so publish backend here)
BACKEND_PORT=8081
# Use a long, random value in production (min 256-bit for JWT signing).
JWT_SECRET=change_me_to_a_long_random_secret_key_at_least_32_chars
JWT_EXPIRATION_MS=3600000

# --- Frontend ---
FRONTEND_PORT=5173
